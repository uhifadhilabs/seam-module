<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true">
    <php>
        <env name="KERNEL_CLASS" value="UhifadhiLabs\Trunk\Tests\Integration\TestKernel"/>
        <!--
            The trunk owns the platform's catalogue tables — the catalogue and
            the per-area install record are its data, not its host's — so unlike
            its sibling bundles it genuinely connects. There is no honest
            version of this suite that does not.
        -->
        <env name="TRUNK_TEST_DATABASE_URL"
             value="postgresql://app:app@127.0.0.1:5434/trunk_bundle_test?serverVersion=17&amp;charset=utf8"/>
    </php>
    <testsuites>
        <!--
            ONE SUITE. There were two while the runtime was still in the host and
            its specification was here ahead of it, so that "red by design" could
            never be mistaken for "broken". The extraction closed that gap: every
            test here is green and a failure is a failure.
        -->
        <testsuite name="default">
            <directory>tests/Unit</directory>
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
