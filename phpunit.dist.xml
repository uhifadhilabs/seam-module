<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true">
    <php>
        <env name="KERNEL_CLASS" value="UhifadhiLabs\Trunk\Tests\Integration\TestKernel"/>
        <!--
            The trunk owns the platform's catalogue tables, so it WILL connect —
            but not until the extraction brings the entities across. The scaffold
            suite boots the kernel and opens no connection; the phase2 suite is
            written against this database on the fundi cluster (port 5434).
        -->
        <env name="TRUNK_TEST_DATABASE_URL"
             value="postgresql://app:app@127.0.0.1:5434/trunk_bundle_test?serverVersion=17&amp;charset=utf8"/>
    </php>
    <testsuites>
        <!--
            GREEN, AND IT STAYS GREEN. The scaffold: the bundle boots, its
            container compiles, its config tree holds, an installation with no
            modules at all is harmless, and the boundaries hold. This is what
            `composer test` and CI run.
        -->
        <testsuite name="scaffold">
            <directory>tests/Unit</directory>
            <directory>tests/Integration</directory>
        </testsuite>
        <!--
            RED BY DESIGN. The behavioural specification of the seam runtime,
            written before the runtime exists: phase 2 satisfies it by
            EXTRACTING the implementation from the host. Run it with
            `composer test:phase2` and expect errors — a test here that passes
            today would mean it asserts nothing.

            It is a separate suite, not a skipped one, so "red by design" and
            "broken" can never be confused: CI runs `scaffold` and must be
            green; `phase2` is the todo list, and the extraction is done when
            this suite is green and these files have moved into the two
            directories above.
        -->
        <testsuite name="phase2">
            <directory>tests/Phase2</directory>
        </testsuite>
    </testsuites>
    <source restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>